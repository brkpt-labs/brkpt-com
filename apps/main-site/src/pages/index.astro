---
import Layout from '../layouts/BaseLayout.astro';

const products = [
  {
    name: 'brkpt-auth',
    description:
      'Transparent, composable authentication for NestJS. Installed as source, not a black box.',
    href: '/auth/',
  },
  {
    name: 'brkpt-cli',
    description: 'The command-line tool that scaffolds brkpt projects.',
    href: '/cli/',
  },
];
---

<Layout
  title='brkpt — Open-source, composable developer tools for NestJS'
  description='brkpt builds composable, portable developer tools for NestJS, starting with brkpt-auth.'
  og
>
  <h1>brkpt builds open-source developer tools for NestJS.</h1>
  <p class='lede'>
    Composable, portable, and built to extend. Starting with brkpt-auth.
  </p>

  <ul class='products'>
    {
      products.map((p) => (
        <li>
          <a href={p.href}>
            <span class='name'>
              {p.name}
              <span class='arrow'>→</span>
            </span>
            <span class='description'>{p.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
